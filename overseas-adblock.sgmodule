#!name=海外版去广告合集
#!desc=YouTube去广告 + Spotify去广告 + 苹果APNs推送（三合一，新设备一键安装）
#!author=cc合集 (来源: ithtelab/sr-adblock, ttyyss2233/Tool)
#!homepage=https://github.com/aliang-crypto/MyRules
#!update=2026-10-11
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,启用调试模式:false,字幕翻译语言:off,歌词翻译:false,翻译账户:申请并填入百度翻译AppID,翻译密钥:申请并填入百度翻译密钥,精简底栏:true,接力功能:true
#!arguments-desc=\n▶ YouTube 参数:\n - 屏蔽按钮: 默认开启，可手动切换\n - 调试模式: 默认关闭\n - 翻译语言: 默认关闭，可自定义语言代码（如 zh-Hans）\n\n▶ Spotify 参数:\n - 歌词翻译需申请百度翻译API并填入ID/密钥

# ==========================================================================
# 海外版去广告合集 (三合一)
#   1. YouTube去广告 (来源: ithtelab/sr-adblock → iab0x00/ProxyRules)
#   2. Spotify去广告 (来源: ithtelab/sr-adblock → LOWERTOP/Shadowrocket-First)
#   3. 苹果APNs推送 (来源: ttyyss2233/Tool)
#
# 脚本均为远程加载，上游更新脚本后自动生效。
# 模块本身（规则/MITM域名）如需更新，重新下载本文件即可。
# ==========================================================================

[Rule]
# --- Spotify QUIC BLOCK ---
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT-NO-DROP
# --- 苹果APNs推送 ---
DOMAIN-SUFFIX,push.apple.com,PROXY
DOMAIN-SUFFIX,akadns.net,PROXY
DOMAIN-KEYWORD,apple.com.edgekey.net,PROXY
IP-CIDR,17.249.0.0/16,PROXY,no-resolve
IP-CIDR,17.252.0.0/16,PROXY,no-resolve
IP-CIDR,17.57.144.0/22,PROXY,no-resolve
IP-CIDR,17.188.128.0/18,PROXY,no-resolve
IP-CIDR,17.188.20.0/23,PROXY,no-resolve
IP-CIDR6,2620:149:a44::/48,PROXY,no-resolve
IP-CIDR6,2403:300:a51::/48,PROXY,no-resolve
IP-CIDR6,2a01:b740:a42::/48,PROXY,no-resolve

[URL Rewrite]
# Spotify
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad header

[Map Local]
# Spotify
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:ad-|pendragon) data-type=text data="" status-code=200

[Script]
# --- YouTube ---
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,requires-body=true,binary-body-mode=true,max-size=0,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,requires-body=true,binary-body-mode=true,max-size=0,argument="{"captionLang":"{{{字幕翻译语言}}}}}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,requires-body=true,binary-body-mode=true,max-size=0
# --- Spotify ---
Spotify.Crack = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service),script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/001ProMax/Surge/refs/heads/main/Script/Spotify.Crack.Dev.js,requires-body=true,binary-body-mode=true,argument=tab={{{精简底栏}}}&useractivity={{{接力功能}}}
spotify歌词翻译 = type=http-response,pattern=^https:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/app2smile/rules/master/js/spotify-lyric.js,enable={{{歌词翻译}}},argument=appid={{{翻译账户}}}&securityKey={{{翻译密钥}}}

[MITM]
hostname = %APPEND% *.googlevideo.com,youtubei.googleapis.com,spclient.wg.spotify.com,*spclient.spotify.com
