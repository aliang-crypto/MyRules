#!name=My Global Routing Rules
#!desc=集中管理所有私有分流：传统金融直连 / 加密分 TW-HK / AI流媒体走 DMIT-US

[Rule]
# =====================================================================
# 自建分组说明（由 sync.yml 在 My_Auto.conf 的 [Proxy Group] 顶部自动注入）：
#   DMIT-US ＝ 自建美国分组 → AI / 流媒体 / 未命中流量（FINAL）
#   TW      ＝ 自建台湾分组 → 除预测市场外的全部加密流量
#   HK      ＝ 自建香港分组 → 预测市场（Polymarket / Predict.fun）
# 导入小火箭后，在"代理分组"里点选每个分组的具体节点即可，无需改名。
# =====================================================================

# --- 1. 传统金融 (直连，置顶，风控敏感严禁走代理) ---
RULE-SET,https://cdn.jsdelivr.net/gh/aliang-crypto/MyRules@main/oldmoney.list,DIRECT

# --- 2. 预测市场 → HK ---
# Polymarket / Predict.fun：台湾双重封锁打不开，香港技术可达
RULE-SET,https://cdn.jsdelivr.net/gh/aliang-crypto/MyRules@main/crypto_hk.list,HK

# --- 3. 加密资产全量 → TW ---
# CEX / 钱包 / DeFi / 公链 / 行情 / NFT / 矿池（Bybit 必须走台湾，平台自限香港 IP）
RULE-SET,https://cdn.jsdelivr.net/gh/aliang-crypto/MyRules@main/crypto_tw.list,TW

# --- 4. AI 与流媒体 → DMIT-US ---
RULE-SET,https://cdn.jsdelivr.net/gh/aliang-crypto/MyRules@main/ai_us.list,DMIT-US
